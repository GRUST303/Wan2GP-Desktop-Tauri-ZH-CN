    {
      "regex": "^Number of frames\\s*\\((\\d+)\\s*frames\\s*=\\s*1s\\),\\s*current duration:\\s*(.+)$",
      "replacement": "帧数 (Number of frames)（$1 帧 = 1 秒），当前时长：$2"
    },
    {
      "regex": "^Current duration:\\s*(.+)$",
      "replacement": "当前时长 (Current duration)：$1"
    },
    {
      "regex": "^Generation time:\\s*(.+)$",
      "replacement": "生成耗时 (Generation time)：$1"
    },
    {
      "regex": "^Model loading time:\\s*(.+)$",
